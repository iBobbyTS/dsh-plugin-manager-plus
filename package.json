{
  "name": "dsh-plugin-manager-plus",
  "description": "Enhanced plugin manager for DeepSeek Harness — browse community plugins, distinguish official/third-party, sync environments via GitHub. Based on dsh-market. · DSH 插件管理器：浏览社区插件、区分官方/第三方、GitHub 环境同步。基于 dsh-market。",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdllang/dsh-plugin-manager-plus.git"
  },
  "homepage": "https://github.com/cdllang/dsh-plugin-manager-plus",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "plugin-manager",
    "sync",
    "marketplace"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc -p tsconfig.json && npm run build:client",
    "build:client": "tsdown && node scripts/normalize-client-banner.mjs",
    "check": "npm run typecheck && npm run build && node scripts/restart-smoke.mjs",
    "test": "vitest run",
    "test:compat": "vitest run --config vitest.compat.config.ts",
    "validate:registry": "node scripts/validate-registry.mjs",
    "snapshot": "curl -sf https://awesome-dsh-plugin.com/plugins.json -o data/registry-snapshot.json",
    "test:web": "vitest run --config vitest.web.config.ts",
    "prepublishOnly": "npm run build && node scripts/preflight.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client",
    "data",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.0.1-rc.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "~18.3.1",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
